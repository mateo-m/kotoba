{
  "name": "kotoba",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "format": "bin/ruby18 bin/format",
    "lint": "bin/ruby18 bin/lint && bin/lint-docker",
    "lint:ruby": "bin/ruby18 bin/lint",
    "lint:docker": "bin/lint-docker",
    "hooks:install": "lefthook install",
    "precommit": "lefthook run pre-commit",
    "docs:dev": "blume dev",
    "docs:build": "blume build --strict",
    "docs:preview": "blume preview",
    "docs:check": "blume validate --strict",
    "docs:version": "blume version"
  },
  "dependencies": {
    "blume": "^1.5.1"
  },
  "devDependencies": {
    "lefthook": "^2.1.9",
    "typescript": "^5.7.3"
  }
}
