{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["blume.config.ts", "docs-site-config.ts", "docs/**/meta.ts"],
  "exclude": [".blume", "dist", "node_modules"]
}
